# ==============================================================================
# PashuPrahari - Environment Configuration Template
# Copy this file to Backend/.env and/or API/.env and replace placeholders with
# your actual credentials. DO NOT commit .env files containing real secrets.
# ==============================================================================

# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/pashuprahari

# AI & LLM Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: Alternative OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=10000

# Twilio SMS Alert Service Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_API_KEY_SID=your_restricted_api_key_sid_here
TWILIO_API_KEY_SECRET=your_restricted_api_key_secret_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
ALERT_RECIPIENT_PHONE=+919876543210
